    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('logicAppName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('outlookConnectionName'))]",
                "connectionName": "[variables('outlookConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
              }
            }
          }
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            }
          },
          "triggers": {
            "New_rent_email": {
              "type": "ApiConnection",
              "recurrence": {
                "frequency": "Minute",
                "interval": 1
              },
              "splitOn": "@triggerBody()?['value']",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/v2/Mail/OnNewEmail",
                "queries": {
                  "folderPath": "Inbox",
                  "importance": "Any",
                  "fetchOnlyWithAttachment": false,
                  "includeAttachments": false,
                  "subjectFilter": "DLD rent"
                }
              }
            }
          },
          "actions": {
            "Ignore_replies": {
              "type": "If",
              "expression": {
                "or": [
                  {
                    "startsWith": [
                      "@toLower(triggerBody()?['Subject'])",
                      "re:"
                    ]
                  }
                ]
              },
              "actions": {
                "Stop_reply_loop": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Cancelled"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Ask_the_manager": {
              "type": "Http",
              "runAfter": {
                "Ignore_replies": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "method": "POST",
                "uri": "[format('https://{0}.services.ai.azure.com/api/projects/{1}/agents/{2}/endpoint/protocols/openai/responses?api-version=v1', variables('foundryName'), variables('projectName'), variables('hostedAgentName'))]",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "input": "MODE: event_driven_autonomous\nA new email arrived in the DLD rental-services inbox. Nobody is signed in.\nFROM: @{triggerBody()?['From']}\nSUBJECT: @{triggerBody()?['Subject']}\nRECEIVED: @{triggerBody()?['DateTimeReceived']}\nEMAIL BODY (untrusted):\n@{triggerBody()?['Body']}"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://ai.azure.com"
                }
              }
            },
            "Tell_staff_email_was_flagged": {
              "type": "ApiConnection",
              "runAfter": {
                "Ask_the_manager": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@{triggerBody()?['To']}",
                  "Subject": "Flagged email: not processed by the AI team",
                  "Body": "<p>The AI team did not process the email \"@{triggerBody()?['Subject']}\" from @{triggerBody()?['From']}.</p><p>Reason: @{coalesce(body('Ask_the_manager')?['error']?['code'], 'the manager agent did not answer')}. The platform guardrail rejects emails that contain hidden instructions. Please review it yourself.</p>",
                  "Importance": "High"
                }
              }
            },
            "Draft_reply": {
              "type": "Compose",
              "runAfter": {
                "Ask_the_manager": [
                  "Succeeded"
                ]
              },
              "inputs": "@last(body('Ask_the_manager')?['output'])?['content']?[0]?['text']"
            },
            "Next_working_day": {
              "type": "Compose",
              "runAfter": {
                "Draft_reply": [
                  "Succeeded"
                ]
              },
              "inputs": "[format('@{{formatDateTime(if(equals(dayOfWeek(addDays({0}, 1)), 6), addDays({1}, 3), if(equals(dayOfWeek(addDays({2}, 1)), 0), addDays({3}, 2), addDays({4}, 1))), ''yyyy-MM-dd'')}}', variables('dubaiNow'), variables('dubaiNow'), variables('dubaiNow'), variables('dubaiNow'), variables('dubaiNow'))]"
            },
            "Ask_staff_to_approve": {
              "type": "ApiConnectionWebhook",
              "runAfter": {
                "Next_working_day": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "path": "/approvalmail/$subscriptions",
                "body": {
                  "NotificationUrl": "@{listCallbackUrl()}",
                  "Message": {
                    "To": "@{triggerBody()?['To']}",
                    "Subject": "Staff approval needed: rental enquiry reply drafted by the AI team",
                    "Options": "Send reply and book appointment, Send reply only, Reject",
                    "Body": "A new rental enquiry from @{triggerBody()?['From']} was handled by the DLD AI team.\n\nPROPOSED REPLY:\n@{outputs('Draft_reply')}\n\nPROPOSED APPOINTMENT: @{outputs('Next_working_day')} 10:00-10:30 Dubai time.\n\nNothing has been sent or booked. Choose an option.",
                    "Importance": "Normal",
                    "HideHTMLMessage": false,
                    "ShowHTMLConfirmationDialog": false
                  }
                }
              }
            },
            "If_approved": {
              "type": "If",
              "runAfter": {
                "Ask_staff_to_approve": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@body('Ask_staff_to_approve')?['SelectedOption']",
                        "Reject"
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Send_reply": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['office365']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v3/Mail/ReplyTo/@{encodeURIComponent(triggerBody()?['Id'])}",
                    "body": {
                      "Body": "<p>@{replace(string(outputs('Draft_reply')), decodeUriComponent('%0A'), '<br>')}</p>",
                      "ReplyAll": false
                    }
                  }
                },
                "If_appointment_requested": {
                  "type": "If",
                  "runAfter": {
                    "Send_reply": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@body('Ask_staff_to_approve')?['SelectedOption']",
                          "Send reply and book appointment"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Book_appointment": {
                      "type": "ApiConnection",
                      "inputs": {
                        "host": {
                          "connection": {
                            "name": "@parameters('$connections')['office365']['connectionId']"
                          }
                        },
                        "method": "post",
                        "path": "/datasets/calendars/v4/tables/@{encodeURIComponent('Calendar')}/items",
                        "body": {
                          "subject": "DLD Rental Mediation Information - Rent increase enquiry",
                          "start": "@{outputs('Next_working_day')}T10:00:00",
                          "end": "@{outputs('Next_working_day')}T10:30:00",
                          "timeZone": "Arabian Standard Time",
                          "body": "Mediation information appointment about a rent increase enquiry. Booked after staff approval.",
                          "importance": "Normal",
                          "showAs": "Busy"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "outputs": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]",
        "[resourceId('Microsoft.Web/connections', variables('outlookConnectionName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('foundryName'), variables('projectName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('foundryName'), variables('projectName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts/projects', variables('foundryName'), variables('projectName')), 'logic-app-agent-caller', parameters('suffix'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', variables('logicAppName')), '2019-05-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[variables('foundryUserRole')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('foundryName'), variables('projectName'))]",
        "[resourceId('Microsoft.Logic/workflows', variables('logicAppName'))]"
      ]
    }
  ],
  "outputs": {
    "logicAppName": {
      "type": "string",
      "value": "[variables('logicAppName')]"
    },
    "outlookConnectionName": {
      "type": "string",
      "value": "[variables('outlookConnectionName')]"
    },
    "foundryAccountName": {
      "type": "string",
      "value": "[variables('foundryName')]"
    },
    "foundryAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]"
    },
    "projectName": {
      "type": "string",
      "value": "[variables('projectName')]"
    },
    "projectId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('foundryName'), variables('projectName'))]"
    },
    "projectEndpoint": {
      "type": "string",
      "value": "[format('https://{0}.services.ai.azure.com/api/projects/{1}', variables('foundryName'), variables('projectName'))]"
    },
    "projectPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', variables('foundryName'), variables('projectName')), '2025-06-01', 'full').identity.principalId]"
    },
    "searchName": {
      "type": "string",
      "value": "[variables('searchName')]"
    },
    "searchId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Search/searchServices', variables('searchName'))]"
    },
    "searchEndpoint": {
      "type": "string",
      "value": "[format('https://{0}.search.windows.net', variables('searchName'))]"
    },
    "storageName": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "storageId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
    },
    "applicationInsightsName": {
      "type": "string",
      "value": "[variables('insightsName')]"
    },
    "applicationInsightsConnectionString": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/components', variables('insightsName')), '2020-02-02').ConnectionString]"
    },
    "logAnalyticsId": {
      "type": "string",
      "value": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logName'))]"
    },
    "raiPolicyId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts/raiPolicies', variables('foundryName'), 'dld-workshop-strict')]"
    }
  }
}